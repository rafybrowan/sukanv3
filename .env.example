# ============================================================
# SUKAN RIVER TUBING — Contoh Environment Variables
# Salin file ini menjadi .env lalu sesuaikan nilainya:
#   cp .env.example .env
# JANGAN pernah meng-commit file .env asli ke GitHub.
# ============================================================

# --- Database (WAJIB) ---
# Lokal (Windows/macOS/Linux): path relatif terhadap folder prisma/
DATABASE_URL="file:../db/custom.db"

# Produksi di Railway dengan volume persisten ter-mount di /data:
# DATABASE_URL="file:/data/custom.db"

# Produksi di Vercel + Neon PostgreSQL (setelah provider di schema.prisma
# diubah menjadi "postgresql"):
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Keamanan sesi admin (SANGAT DISARANKAN untuk produksi) ---
# Generate nilai acak: openssl rand -hex 32
# Jika kosong, dipakai secret bawaan (HANYA untuk pengembangan lokal).
ADMIN_SESSION_SECRET="ganti-dengan-string-acak-yang-panjang"
